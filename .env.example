# Copy this file to .env (start.bat does it for you and fills in random passwords).
# The .env file stays on your computer. It is listed in .gitignore, so it is never uploaded.

# Database password. Use letters and digits only.
POSTGRES_PASSWORD=change-me

# OpenVAS (Greenbone Community Edition) runs next to the dashboard. Set to off to run the
# dashboard alone and import scan reports by hand.
OPENVAS=on

# Password of the "admin" user that OpenVAS creates on its first start. The dashboard
# uses it to talk to OpenVAS. You only need it yourself to log in to the optional
# Greenbone web interface at https://127.0.0.1. Letters and digits only.
OPENVAS_PASSWORD=change-me

# How often finished OpenVAS reports are pulled into the dashboard, in minutes.
# 0 turns the automatic import off (the Sync now button still works).
OPENVAS_SYNC_MINUTES=10

# Results below this quality of detection (0 to 100) are ignored. 70 is Greenbone's default.
OPENVAS_MIN_QOD=70

# AI triage (optional). Keep "none" to leave it off, or set "ollama" to use a local model.
AI_PROVIDER=none

# The name of a model you have pulled in Ollama. Run "ollama list" to see yours.
OLLAMA_MODEL=

# Where the app finds Ollama. This default reaches Ollama running on the same PC.
OLLAMA_URL=http://host.docker.internal:11434

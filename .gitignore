# Secrets and local settings: never commit these
.env

# Real scan exports and reports describe your network. Only the synthetic demo files
# and the dashboard's own page belong in git.
*.nessus
!backend/tests/fixtures/nessus/demo-scan-*.nessus
*.html
*.htm
!backend/app/static/*.html
scans/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local databases
*.db
*.sqlite3

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# OpenVAS reports exported by hand, and database backups: both describe your network.
*.xml
!sample-data/openvas-demo-*.xml
backups/
*.dump

      <ReportItem port="445" svc_name="cifs" protocol="tcp" severity="3" pluginID="900002" pluginName="Windows SMBv1 remote code execution (EternalBlue)" pluginFamily="Windows">
        <cve>CVE-2017-0143</cve>

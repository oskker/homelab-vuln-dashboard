      <ReportItem port="8080" svc_name="www" protocol="tcp" severity="4" pluginID="900001" pluginName="Apache Log4j remote code execution (Log4Shell)" pluginFamily="Web Servers">
        <cve>CVE-2021-44228</cve>
        <cvss3_base_score>10.0</cvss3_base_score>
        <cvss3_vector>CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H</cvss3_vector>
        <synopsis>A Java application on the host uses a Log4j version that runs attacker-supplied code.</synopsis>
        <description>The application logs request data with a Log4j 2 release that resolves JNDI lookups inside log messages. A single crafted request is enough to load and run remote code.</description>
        <solution>Upgrade the application to a release that bundles a fixed Log4j version.</solution>
        <exploit_available>true</exploit_available>
        <plugin_output>A JNDI lookup placed in a request header triggered a callback.</plugin_output>
      </ReportItem>
